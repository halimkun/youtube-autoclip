# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=123456789,987654321

# LLM (endpoint OpenAI-compatible — bebas ganti provider tanpa ubah kode)
# Contoh: OpenRouter https://openrouter.ai/api/v1
#         HF Inference Providers https://router.huggingface.co/v1
#         Ollama lokal http://localhost:11434/v1 (api key boleh dummy)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Aturan klip
CLIP_MIN_SECONDS=30
CLIP_MAX_SECONDS=180
MAX_CLIPS_PER_VIDEO=8

# Transkripsi
WHISPER_MODEL=small

# Path data
DATA_DIR=./data
